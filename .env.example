NODE_ENV=development
PORT=3001

# URL del proyecto Supabase
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# SOLO BACKEND. Nunca usar prefijo VITE_ ni subir a Git.
SUPABASE_SERVICE_ROLE_KEY=PEGAR_SERVICE_ROLE_KEY_SOLO_EN_EL_SERVIDOR

# Orígenes permitidos, separados por coma.
DRITO_FRONTEND_URLS=http://localhost:5173

# 32 bytes codificados en Base64.
# Generar una sola vez:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRITO_ARCA_MASTER_KEY=PEGAR_CLAVE_BASE64_DE_32_BYTES

ARCA_CREDENTIALS_BUCKET=arca-credenciales

# Opcional. Si openssl no está en PATH, indicar la ruta absoluta.
ARCA_OPENSSL_PATH=openssl
